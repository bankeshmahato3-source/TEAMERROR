{
  "name": "payguard-backend",
  "version": "1.0.0",
  "description": "PayGuard - Fintech & Cybersecurity Fraud Detection Backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "tsx src/seed/seed.ts",
    "crawler": "tsx src/crawler/scripts/runWorker.ts",
    "crawler:seed": "tsx src/crawler/scripts/seedCrawler.ts",
    "crawler:test": "vitest run src/crawler/__tests__/"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ipaddr.js": "^2.5.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "playwright": "^1.63.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.10.7",
    "@types/ws": "^8.18.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^5.0.3"
  }
}
